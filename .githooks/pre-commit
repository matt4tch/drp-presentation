#!/bin/sh

set -eu

if ! command -v typst >/dev/null 2>&1; then
  printf '%s\n' 'pre-commit: Typst is required to compile the project documents.' >&2
  printf '%s\n' 'Install Typst and try the commit again.' >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/drp-pre-commit.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT

cd "$repo_root"

for source in slides.typ drp.typ; do
  output="$tmp_dir/${source%.typ}.pdf"
  printf 'pre-commit: compiling %s...\n' "$source"
  if ! typst compile "$source" "$output"; then
    printf 'pre-commit: %s failed to compile.\n' "$source" >&2
    exit 1
  fi
  printf 'pre-commit: %s compiled successfully.\n' "$source"
done
